{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "PORT",
    "ALLOWED_API_ORIGINS",
    "API_INTERNAL_URL",
    "SUPABASE_URL",
    "SUPABASE_KEY"
  ],
  "ui": "stream",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["generated/**"]
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "dependsOn": ["^build", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"],
      "passThroughEnv": ["NEXT_PUBLIC_API_URL", "API_INTERNAL_URL"]
    },
    "start": {
      "cache": false
    },
    "test": {
      "cache": false,
      "dependsOn": ["db:generate"]
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "persistent": true,
      "cache": false,
      "dependsOn": ["db:generate"]
    },
    "format": {},
    "lint": {
      "dependsOn": ["^topo"]
    },
    "lint:fix": {
      "dependsOn": ["^topo"],
      "cache": false
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["db:generate"]
    }
  }
}
