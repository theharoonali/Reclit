{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_REPLICA_URL",
    "SUPABASE_URL",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_JWT_SECRET",
    "ALLOWED_API_ORIGINS",
    "INTERNAL_API_KEY",
    "APP_ENCRYPTION_KEY",
    "API_URL",
    "API_INTERNAL_URL",
    "DASHBOARD_URL"
  ],
  "ui": "stream",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "next-env.d.ts",
        ".expo/**",
        "dist/**",
        "build/**",
        "lib/**"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_REPLICA_URL",
        "SUPABASE_URL",
        "SUPABASE_SECRET_KEY",
        "NEXT_PUBLIC_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "APP_ENCRYPTION_KEY",
        "INTERNAL_API_KEY"
      ]
    },
    "start": {
      "cache": false
    },
    "test": {
      "cache": false,
      "env": ["TEST_DATABASE_URL"]
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "persistent": true,
      "cache": false
    },
    "format": {},
    "lint": {
      "dependsOn": ["^topo"]
    },
    "lint:fix": {
      "dependsOn": ["^topo"],
      "cache": false
    },
    "typecheck": {
      "outputs": []
    }
  }
}
