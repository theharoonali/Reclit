// Prisma schema for the API. Docs: https://pris.ly/d/prisma-schema
//
// The connection URL is not declared here — `prisma.config.ts` reads it from
// DATABASE_URL (Prisma 7 config-based datasource).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Automated-processing kind for a column. Absence (null) means a plain
/// column; more kinds will be added.
enum NodeType {
  AI
  EMAIL
  GOOGLE_SEARCH
}

enum ColumnType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  JSON
  FORMULA
  AUDIO
  FILE
  EMAIL
  URL
}

/// The person using the app. There is no auth yet: exactly one user is seeded
/// and every workspace belongs to them (docs/plans/013-workspaces.md).
/// `onboardingCompleted` flips once `POST /onboarding` has created the user's
/// first workspace from an upload (docs/plans/027-onboarding.md).
model User {
  id                  String      @id @default(uuid())
  name                String
  email               String?
  imageUrl            String?
  onboardingCompleted Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  workspaces          Workspace[]
  company             Company?
}

/// What the user will use Reclit for; several may be picked
/// (docs/plans/043-company-profile.md).
enum UseCase {
  LEAD_RESEARCH
  HIRING
  EMAIL_OUTREACH
  FORM_INTAKE
  CUSTOMER_INSIGHTS
  OTHER
}

/// The website half of a company profile: IDLE (no website yet) → SCRAPING
/// (the homepage, synchronously) → CRAWLING (the background crawl) → READY,
/// or FAILED with `crawlError` (the scrape summary is kept).
enum CompanyCrawlStatus {
  IDLE
  SCRAPING
  CRAWLING
  READY
  FAILED
}

enum CompanyDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// The account-level company profile: one per user, created on first read.
/// Compiled into one `<company-context>` block placed first in every Gemini
/// system prompt (modules/company/company-context.service.ts). `contextHash`
/// is the sha256 of that block; the three `geminiCache*` columns record the
/// explicit Gemini cache built from it (ai/gemini-cache.ts). Those four are
/// bookkeeping and are written without moving `updatedAt`. The migration
/// `add_company` adds a trigger that `pg_notify`s the company id on
/// `company_changed` for every write to this table and to CompanyDocument.
model Company {
  id                   String             @id @default(uuid())
  ownerId              String             @unique
  useCases             UseCase[]
  useCaseOther         String?
  website              String?
  name                 String?
  iconUrl              String?
  summary              String?
  rules                String?
  crawlStatus          CompanyCrawlStatus @default(IDLE)
  crawlError           String?
  crawledAt            DateTime?
  contextHash          String?
  geminiCacheName      String?
  geminiCacheHash      String?
  geminiCacheExpiresAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  owner                User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pages                CompanyPage[]
  documents            CompanyDocument[]
}

/// One page of the company website's background crawl. A crawl replaces
/// every page of the company. (`ExternalApi` cannot hold these: its `cellId`
/// is a required foreign key.)
model CompanyPage {
  id        String   @id @default(uuid())
  companyId String
  url       String
  title     String?
  markdown  String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// A document the user uploaded through `POST /files` for the company
/// profile, digested once by Gemini into `digest` (markdown) by the
/// `process-company-document` task.
model CompanyDocument {
  id        String                @id @default(uuid())
  companyId String
  url       String
  name      String
  mimeType  String
  size      Int
  status    CompanyDocumentStatus @default(PENDING)
  digest    String?
  error     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

/// A workspace owns spreadsheets. The relation is one-to-many for future
/// scope; the app creates exactly one sheet per workspace today, named after
/// the workspace.
model Workspace {
  id           String        @id @default(uuid())
  name         String
  ownerId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  spreadsheets  Spreadsheet[]
  dashboard     Dashboard?
  assistantRuns AssistantRun[]
  dashboardGenerations DashboardGeneration[]

  @@index([ownerId])
  @@index([createdAt])
}

model Spreadsheet {
  id               String            @id @default(uuid())
  name             String
  /// What the sheet holds, written by the onboarding wizard's AI and edited by the user.
  description      String?
  /// "We see it as": a short label for what the sheet is ("Hiring pipeline").
  purpose          String?
  /// The public form shows the AI columns of a submitted row filling in live.
  formOutputEnabled Boolean         @default(false)
  totalRows        Int               @default(5000000)
  workspaceId      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns          Column[]
  rows             Row[]
  cells            Cell[]
  dashboardWidgets DashboardWidget[]
  assistantRuns    AssistantRun[]
  dashboardGenerations DashboardGeneration[]

  @@index([createdAt])
  @@index([workspaceId])
}

/// id is the deterministic scoped key "<sheetId>.col.<index>" — the wire id is
/// the short "col.<index>" (docs/plans/005-spreadsheet-backend.md).
model Column {
  id            String      @id
  spreadsheetId String
  index         Int
  /// Display position, dense 0..n-1 per sheet. Unlike `index` — which is
  /// identity, baked into the pk and into every cell address — this is free to
  /// move; createColumn, removeColumn and reorderColumn are the only writers.
  /// Deliberately NOT @@unique: a reorder shifts a whole band in one
  /// updateMany, and Postgres checks uniqueness per row mid-statement, so a
  /// unique constraint would collide transiently. Contiguity is a service
  /// invariant (spreadsheet-columns.service.ts), not a database one.
  sortOrder     Int
  name          String
  type          ColumnType  @default(STRING)
  node          NodeType?
  prompt        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  spreadsheet   Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@unique([spreadsheetId, index])
  @@index([spreadsheetId, sortOrder])
}

/// id is "<sheetId>.row.<index>". Rows are sparse: a record exists only where
/// something was written; every other index is a blank, editable row.
model Row {
  id            String      @id
  spreadsheetId String
  index         Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  spreadsheet   Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@unique([spreadsheetId, index])
}

/// id is "<sheetId>.cell.<rowIndex>.<columnIndex>" — a cell write is one
/// upsert by pk with no prior lookup. A cleared cell is a deleted record;
/// `value` is never stored as null.
model Cell {
  id            String        @id
  spreadsheetId String
  rowIndex      Int
  columnIndex   Int
  value         Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  spreadsheet   Spreadsheet   @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)
  externalApis  ExternalApi[]

  @@unique([spreadsheetId, rowIndex, columnIndex])
  @@index([spreadsheetId, rowIndex])
}

/// One AI run for one cell. `cellId` is the scoped Cell pk
/// "<sheetId>.cell.<row>.<col>" kept as a plain string, NOT a relation: Cell
/// rows are deleted on clear and wiped on import, and the run record must
/// outlive them. `spreadsheetId` is the sheet half of that key, denormalised
/// so the live feed and the snapshot query filter by sheet through an index.
/// `batchId` groups every run one user action enqueued.
///
/// `status` is free text, uppercase: PENDING | RUNNING | COMPLETED | FAILED
/// or any custom working stage (ANALYZING, ...). COMPLETED and FAILED are the
/// terminal values. Two things the schema cannot express live in the
/// migration `run_ai_status_text_and_feed`: a partial unique index that
/// allows one non-terminal run per cell, and an AFTER INSERT OR UPDATE
/// trigger that `pg_notify`s the row id on channel `run_ai_changed`
/// (modules/run-ai/run-ai.feed.ts listens).
model RunAi {
  id            String   @id @default(uuid())
  cellId        String
  spreadsheetId String
  batchId       String
  status        String   @default("PENDING")
  credit        Int      @default(0)
  result        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cellId])
  @@index([spreadsheetId, updatedAt])
  @@index([batchId])
  @@index([createdAt])
}

/// One result an external service produced for one cell — deliberately
/// generic: audio → text, PDF → text, website → markdown, any future file
/// processing or scraping. `input` is the source reference the result was
/// produced from (a file URL, a website URL, a file name) and is NOT unique: a
/// cell may have several sources, and one source may be processed more than
/// once. `output` is the result as JSON — an object whose `kind` says what
/// produced it (external-api.schema.ts). Unlike `RunAi.cellId` this IS a
/// relation: a processed result describes the cell's current content, so
/// clearing the cell (its row is deleted), deleting the row or re-importing
/// the sheet must take it with them.
model ExternalApi {
  id        String   @id @default(uuid())
  cellId    String
  input     String
  output    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cell      Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@index([cellId, input])
  @@index([cellId, createdAt])
  /// The cross-cell lookup: "has any cell already processed this source?"
  @@index([input, createdAt])
}

/// On the wire these are lowercase ("bar", "md"); dashboard.schema.ts holds
/// the 1:1 case mapping, like ColumnType.
enum DashboardWidgetType {
  STAT
  AREA
  BAR
  LINE
  PIE
  RADAR
  RADIAL
  HEATMAP
  TABLE
}

enum DashboardWidgetHeight {
  SM
  MD
  LG
}

/// One dashboard per workspace, created lazily by the first widget write
/// (docs/plans/029-backend-dashboard.md). It stores configuration only —
/// never data: every widget is computed in the browser from the sheet.
model Dashboard {
  id          String            @id @default(uuid())
  workspaceId String            @unique
  /// null → the page's default title / subtitle.
  title       String?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  widgets     DashboardWidget[]
}

/// A widget's placement and its query. `query` is a WidgetQuery
/// (@reclit/dashboard-engine), validated against the sheet's columns on every
/// write; the service is its only writer.
model DashboardWidget {
  id            String                @id @default(uuid())
  dashboardId   String
  spreadsheetId String
  name          String
  description   String?
  type          DashboardWidgetType
  variant       String                @default("default")
  row           Int
  column        Int
  sort          Int
  height        DashboardWidgetHeight @default(MD)
  query         Json
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  dashboard     Dashboard             @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  spreadsheet   Spreadsheet           @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@index([dashboardId, row, sort])
  @@index([spreadsheetId])
}

/// Which page's tool set an assistant run uses. Lowercase on the wire;
/// assistant.schema.ts holds the 1:1 case mapping.
enum AssistantScope {
  DASHBOARD
  SPREADSHEET
}

/// Who started the run: a person through the header capsule, or the system
/// (onboarding, a job). Lowercase on the wire.
enum AssistantSource {
  USER
  SYSTEM
}

/// One assistant run: a prompt, the steps the model took through the tools and
/// where it stands (docs/plans/030-assistant-island.md). `status` is free
/// text, uppercase: PENDING | THINKING | WORKING | AWAITING_CONFIRMATION |
/// COMPLETED | FAILED | CANCELLED; the last three are terminal. `steps` is the
/// bounded list of tool calls with summarised inputs; `pendingAction` is the
/// destructive call waiting for the user while the status is
/// AWAITING_CONFIRMATION; `transcript` is the model conversation, kept for
/// audit and never selected onto the wire; `triggerRunId` is what `cancel`
/// hands to Trigger.dev. Two things the schema cannot express live in the
/// migration `add_assistant_run`: a partial unique index that allows one
/// non-terminal run per workspace, and an AFTER INSERT OR UPDATE trigger that
/// `pg_notify`s the row id on channel `assistant_run_changed`
/// (modules/assistant/assistant.feed.ts listens).
model AssistantRun {
  id            String          @id @default(uuid())
  workspaceId   String
  spreadsheetId String?
  scope         AssistantScope
  source        AssistantSource @default(USER)
  prompt        String
  status        String          @default("PENDING")
  steps         Json            @default("[]")
  pendingAction Json?
  summary       String?
  error         Json?
  model         String?
  usage         Json?
  transcript    Json?
  triggerRunId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spreadsheet   Spreadsheet?    @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
  @@index([createdAt])
}

/// Where a dashboard generation was started from. Lowercase on the wire;
/// dashboard-generation.schema.ts holds the 1:1 case mapping.
enum DashboardGenerationSource {
  ONBOARDING
  DASHBOARD
}

/// One run of the generate-dashboard task: analyze → propose → lay out →
/// verify (→ retry once) → apply (docs/plans/042-dashboard-generation-pipeline.md).
/// `status` is free text, uppercase: PENDING | RUNNING | COMPLETED | FAILED |
/// CANCELLED; the last three are terminal. `phase` is the stage the worker is
/// in (QUEUED … DONE), `attempt` the proposal round (1 or 2), `log` one entry
/// per phase per attempt (what the progress UI lists), `brief` the model's
/// analysis, `result` what was applied and why, `awaitBatchId` the onboarding
/// run-ai batch the task waits for before analyzing. The migration
/// `add_dashboard_generation` adds a partial unique index (one non-terminal
/// generation per workspace) and an AFTER INSERT OR UPDATE trigger that
/// `pg_notify`s the row id on `dashboard_generation_changed`.
model DashboardGeneration {
  id            String                    @id @default(uuid())
  workspaceId   String
  spreadsheetId String
  source        DashboardGenerationSource
  status        String                    @default("PENDING")
  phase         String                    @default("QUEUED")
  attempt       Int                       @default(0)
  awaitBatchId  String?
  log           Json                      @default("[]")
  brief         Json?
  result        Json?
  error         Json?
  model         String?
  usage         Json?
  triggerRunId  String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  workspace     Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spreadsheet   Spreadsheet               @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
  @@index([createdAt])
}
