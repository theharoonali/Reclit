// Prisma schema for the API. Docs: https://pris.ly/d/prisma-schema
//
// The connection URL is not declared here — `prisma.config.ts` reads it from
// DATABASE_URL (Prisma 7 config-based datasource).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Automated-processing kind for a column. Absence (null) means a plain
/// column; more kinds will be added.
enum NodeType {
  AI
  EMAIL
  GOOGLE_SEARCH
}

enum ColumnType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  JSON
  FORMULA
  AUDIO
  FILE
  EMAIL
  URL
}

/// The person using the app. There is no auth yet: exactly one user is seeded
/// and every workspace belongs to them (docs/plans/013-workspaces.md).
/// `onboardingCompleted` flips once `POST /onboarding` has created the user's
/// first workspace from an upload (docs/plans/027-onboarding.md).
///
/// The user also carries the account-level company profile
/// (docs/plans/043-company-profile.md, folded in by 044): use cases, website,
/// summary, rules, the crawl state and `pageCount`. It is compiled into one
/// `<company-context>` block placed first in every model system prompt
/// (modules/company/company-context.service.ts). `contextHash` is the sha256
/// of that block; the three `promptCache*` columns record the explicit prompt
/// cache built from it (ai/prompt-cache.ts). `companyUpdatedAt` moves on
/// every profile or document write and on nothing else: it is the context
/// memo key, and the migration `consolidate_tables` adds a trigger that
/// `pg_notify`s the user id on `company_changed` whenever it moves (and one on
/// CompanyDocument for every write).
model User {
  id                   String             @id @default(uuid())
  name                 String
  email                String?
  imageUrl             String?
  onboardingCompleted  Boolean            @default(false)
  useCases             UseCase[]          @default([])
  useCaseOther         String?
  companyWebsite       String?
  companyName          String?
  companyIconUrl       String?
  companySummary       String?
  companyRules         String?
  crawlStatus          CompanyCrawlStatus @default(IDLE)
  crawlError           String?
  crawledAt            DateTime?
  /// How many pages the last background crawl read.
  pageCount            Int                @default(0)
  contextHash          String?
  promptCacheName      String?
  promptCacheHash      String?
  promptCacheExpiresAt DateTime?
  companyUpdatedAt     DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  workspaces           Workspace[]
  companyDocuments     CompanyDocument[]
}

/// What the user will use Reclit for; several may be picked
/// (docs/plans/043-company-profile.md).
enum UseCase {
  LEAD_RESEARCH
  HIRING
  EMAIL_OUTREACH
  FORM_INTAKE
  CUSTOMER_INSIGHTS
  OTHER
}

/// The website half of a company profile: IDLE (no website yet) → SCRAPING
/// (the homepage, synchronously) → CRAWLING (the background crawl) → READY,
/// or FAILED with `crawlError` (the scrape summary is kept).
enum CompanyCrawlStatus {
  IDLE
  SCRAPING
  CRAWLING
  READY
  FAILED
}

enum CompanyDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// A document the user uploaded through `POST /files` for the company
/// profile, digested once by the model into `digest` (markdown) by the
/// `process-company-document` task.
model CompanyDocument {
  id        String                @id @default(uuid())
  userId    String
  url       String
  name      String
  mimeType  String
  size      Int
  status    CompanyDocumentStatus @default(PENDING)
  digest    String?
  error     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A workspace owns spreadsheets. The relation is one-to-many for future
/// scope; the app creates exactly one sheet per workspace today, named after
/// the workspace.
///
/// The workspace's dashboard lives on it too (docs/plans/029-backend-dashboard.md,
/// folded in by 044): `dashboardCreatedAt` null means "no dashboard yet" — the
/// first widget write sets it, `dashboard.remove` clears it. The dashboard
/// stores configuration only, never data: every widget is computed in the
/// browser from the sheet. `dashboardTitle` / `dashboardDescription` null →
/// the page's default title / subtitle.
model Workspace {
  id                   String            @id @default(uuid())
  name                 String
  ownerId              String
  dashboardCreatedAt   DateTime?
  dashboardTitle       String?
  dashboardDescription String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  owner                User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  spreadsheets         Spreadsheet[]
  dashboardWidgets     DashboardWidget[]
  aiRuns               AiRun[]

  @@index([ownerId])
  @@index([createdAt])
}

model Spreadsheet {
  id                String            @id @default(uuid())
  name              String
  /// What the sheet holds, written by the onboarding wizard's AI and edited by the user.
  description       String?
  /// "We see it as": a short label for what the sheet is ("Hiring pipeline").
  purpose           String?
  /// The public form shows the AI columns of a submitted row filling in live.
  formOutputEnabled Boolean           @default(false)
  totalRows         Int               @default(5000000)
  workspaceId       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns           Column[]
  rows              Row[]
  cells             Cell[]
  dashboardWidgets  DashboardWidget[]

  @@index([createdAt])
  @@index([workspaceId])
}

/// id is the deterministic scoped key "<sheetId>.col.<index>" — the wire id is
/// the short "col.<index>" (docs/plans/005-spreadsheet-backend.md).
model Column {
  id            String      @id
  spreadsheetId String
  index         Int
  /// Display position, dense 0..n-1 per sheet. Unlike `index` — which is
  /// identity, baked into the pk and into every cell address — this is free to
  /// move; createColumn, removeColumn and reorderColumn are the only writers.
  /// Deliberately NOT @@unique: a reorder shifts a whole band in one
  /// updateMany, and Postgres checks uniqueness per row mid-statement, so a
  /// unique constraint would collide transiently. Contiguity is a service
  /// invariant (spreadsheet-columns.service.ts), not a database one.
  sortOrder     Int
  name          String
  type          ColumnType  @default(STRING)
  node          NodeType?
  prompt        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  spreadsheet   Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@unique([spreadsheetId, index])
  @@index([spreadsheetId, sortOrder])
}

/// id is "<sheetId>.row.<index>". Rows are sparse: a record exists only where
/// something was written; every other index is a blank, editable row.
model Row {
  id            String      @id
  spreadsheetId String
  index         Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  spreadsheet   Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@unique([spreadsheetId, index])
}

/// id is "<sheetId>.cell.<rowIndex>.<columnIndex>" — a cell write is one
/// upsert by pk with no prior lookup. A cleared cell is a deleted record;
/// `value` is never stored as null.
model Cell {
  id            String        @id
  spreadsheetId String
  rowIndex      Int
  columnIndex   Int
  value         Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  spreadsheet   Spreadsheet   @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)
  externalApis  ExternalApi[]

  @@unique([spreadsheetId, rowIndex, columnIndex])
  @@index([spreadsheetId, rowIndex])
}

/// What an AI run is for. Each kind has its own service, router and live
/// feed; they share this one table (docs/plans/044-table-consolidation.md).
enum AiRunKind {
  /// One cell of a sheet (modules/run-ai) — onboarding's first fill included.
  CELL
  /// One assistant prompt (modules/assistant).
  ASSISTANT
  /// One dashboard generation (modules/dashboard-generation).
  DASHBOARD
}

/// Who or what started a run. ASSISTANT runs: USER | SYSTEM. DASHBOARD runs:
/// ONBOARDING | DASHBOARD. CELL runs: null. Lowercase on the wire; each
/// feature's schema holds its own 1:1 case mapping.
enum AiRunSource {
  USER
  SYSTEM
  ONBOARDING
  DASHBOARD
}

/// One AI run of any kind. The columns a kind does not use stay null; a
/// `CHECK` in the migration `consolidate_tables` requires the ones it does.
/// Every query filters by `kind`.
///
/// - CELL: `cellId` is the scoped Cell pk "<sheetId>.cell.<row>.<col>" kept as
///   a plain string, NOT a relation — Cell rows are deleted on clear and wiped
///   on import, and the run must outlive them. `spreadsheetId` is its sheet
///   half (also not a relation), `batchId` groups every run one user action
///   enqueued, and `result` holds input, output, model, usage and error.
///   Status: PENDING | RUNNING | COMPLETED | FAILED or any custom working
///   stage; terminal: COMPLETED, FAILED.
/// - ASSISTANT (docs/plans/030-assistant-island.md): `workspaceId`, optional
///   `spreadsheetId`, `scope`, `source`, `prompt`; `steps` is the bounded list
///   of tool calls, `pendingAction` the destructive call waiting while the
///   status is AWAITING_CONFIRMATION, `summary` the answer, `transcript` the
///   model conversation (audit only, never on the wire). Status: PENDING |
///   THINKING | WORKING | AWAITING_CONFIRMATION | COMPLETED | FAILED |
///   CANCELLED; terminal: the last three.
/// - DASHBOARD (docs/plans/042-dashboard-generation-pipeline.md):
///   `workspaceId`, `spreadsheetId`, `source`, `phase` (QUEUED … DONE),
///   `attempt`, `awaitBatchId` (the onboarding cell batch it waits for),
///   `steps` (the per-phase log), `brief`, `result`. Status: PENDING | RUNNING
///   | COMPLETED | FAILED | CANCELLED; terminal: the last three.
///
/// What the schema cannot express lives in the migration: per-kind partial
/// unique indexes (one working run per cell; one per workspace for each of
/// ASSISTANT and DASHBOARD), an AFTER INSERT OR UPDATE trigger that
/// `pg_notify`s the row id on the kind's channel (`run_ai_changed`,
/// `assistant_run_changed`, `dashboard_generation_changed`), and a trigger
/// that deletes a sheet's ASSISTANT and DASHBOARD runs with the sheet.
model AiRun {
  id            String          @id @default(uuid())
  kind          AiRunKind
  workspaceId   String?
  spreadsheetId String?
  cellId        String?
  batchId       String?
  awaitBatchId  String?
  status        String          @default("PENDING")
  source        AiRunSource?
  scope         AssistantScope?
  prompt        String?
  phase         String?
  attempt       Int?
  steps         Json?
  pendingAction Json?
  summary       String?
  brief         Json?
  result        Json?
  error         Json?
  model         String?
  usage         Json?
  transcript    Json?
  triggerRunId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  workspace     Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([kind, spreadsheetId, updatedAt])
  @@index([kind, workspaceId, updatedAt])
  @@index([cellId])
  @@index([batchId])
  @@index([createdAt])
}

/// One result an external service produced for one cell — deliberately
/// generic: audio → text, PDF → text, website → markdown, any future file
/// processing or scraping. `input` is the source reference the result was
/// produced from (a file URL, a website URL, a file name) and is NOT unique: a
/// cell may have several sources, and one source may be processed more than
/// once. `output` is the result as JSON — an object whose `kind` says what
/// produced it (external-api.schema.ts). Unlike `AiRun.cellId` this IS a
/// relation: a processed result describes the cell's current content, so
/// clearing the cell (its row is deleted), deleting the row or re-importing
/// the sheet must take it with them.
model ExternalApi {
  id        String   @id @default(uuid())
  cellId    String
  input     String
  output    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cell      Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@index([cellId, input])
  @@index([cellId, createdAt])
  /// The cross-cell lookup: "has any cell already processed this source?"
  @@index([input, createdAt])
}

/// On the wire these are lowercase ("bar", "md"); dashboard.schema.ts holds
/// the 1:1 case mapping, like ColumnType.
enum DashboardWidgetType {
  STAT
  AREA
  BAR
  LINE
  PIE
  RADAR
  RADIAL
  HEATMAP
  TABLE
}

enum DashboardWidgetHeight {
  SM
  MD
  LG
}

/// A widget's placement and its query, on its workspace's dashboard (the
/// dashboard columns live on Workspace). `query` is a WidgetQuery
/// (@reclit/dashboard-engine), validated against the sheet's columns on every
/// write; the service is its only writer.
model DashboardWidget {
  id            String                @id @default(uuid())
  workspaceId   String
  spreadsheetId String
  name          String
  description   String?
  type          DashboardWidgetType
  variant       String                @default("default")
  row           Int
  column        Int
  sort          Int
  height        DashboardWidgetHeight @default(MD)
  query         Json
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spreadsheet   Spreadsheet           @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@index([workspaceId, row, sort])
  @@index([spreadsheetId])
}

/// Which page's tool set an assistant run uses. Lowercase on the wire;
/// assistant.schema.ts holds the 1:1 case mapping.
enum AssistantScope {
  DASHBOARD
  SPREADSHEET
}
