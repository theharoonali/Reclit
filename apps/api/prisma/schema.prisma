// Prisma schema for the API. Docs: https://pris.ly/d/prisma-schema
//
// The connection URL is not declared here — `prisma.config.ts` reads it from
// DATABASE_URL (Prisma 7 config-based datasource).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Automated-processing kind for a column. Absence (null) means a plain
/// column; more kinds will be added.
enum NodeType {
  AI
  EMAIL
}

enum ColumnType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  JSON
  FORMULA
  AUDIO
  FILE
  EMAIL
  URL
}

/// The person using the app. There is no auth yet: exactly one user is seeded
/// and every workspace belongs to them (docs/plans/013-workspaces.md).
model User {
  id         String      @id @default(uuid())
  name       String
  email      String?
  imageUrl   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workspaces Workspace[]
}

/// A workspace owns spreadsheets. The relation is one-to-many for future
/// scope; the app creates exactly one sheet per workspace today, named after
/// the workspace.
model Workspace {
  id           String        @id @default(uuid())
  name         String
  ownerId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  spreadsheets Spreadsheet[]

  @@index([ownerId])
  @@index([createdAt])
}

model Spreadsheet {
  id          String    @id @default(uuid())
  name        String
  totalRows   Int       @default(5000000)
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     Column[]
  rows        Row[]
  cells       Cell[]

  @@index([createdAt])
  @@index([workspaceId])
}

/// id is the deterministic scoped key "<sheetId>.col.<index>" — the wire id is
/// the short "col.<index>" (docs/plans/005-spreadsheet-backend.md).
model Column {
  id            String      @id
  spreadsheetId String
  index         Int
  name          String
  type          ColumnType  @default(STRING)
  node          NodeType?
  prompt        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  spreadsheet   Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@unique([spreadsheetId, index])
}

/// id is "<sheetId>.row.<index>". Rows are sparse: a record exists only where
/// something was written; every other index is a blank, editable row.
model Row {
  id            String      @id
  spreadsheetId String
  index         Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  spreadsheet   Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@unique([spreadsheetId, index])
}

/// id is "<sheetId>.cell.<rowIndex>.<columnIndex>" — a cell write is one
/// upsert by pk with no prior lookup. A cleared cell is a deleted record;
/// `value` is never stored as null.
model Cell {
  id            String      @id
  spreadsheetId String
  rowIndex      Int
  columnIndex   Int
  value         Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  spreadsheet   Spreadsheet @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  @@unique([spreadsheetId, rowIndex, columnIndex])
  @@index([spreadsheetId, rowIndex])
}
