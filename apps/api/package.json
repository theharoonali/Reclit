{
  "name": "@reclit/api",
  "scripts": {
    "dev": "PORT=4001 bun --watch src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --exit --timeout 30000 src",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
