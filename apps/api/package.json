{
  "name": "@reclit/api",
  "scripts": {
    "dev": "PORT=4001 bun --watch src/main.ts",
    "start": "NODE_ENV=production bun src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --exit --timeout 30000 src",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "bun prisma/seed.ts",
    "postinstall": "prisma generate",
    "trigger:dev": "npx trigger.dev@latest dev"
  },
  "exports": {
    "./trpc/routers/_app": "./src/trpc/routers/_app.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.61",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.112.4",
    "@trigger.dev/sdk": "4.5.15",
    "@trpc/server": "^11.16.0",
    "ai": "^7.0.89",
    "exceljs": "^4.4.0",
    "multer": "^2.2.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "superjson": "^2.2.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.5.15",
    "@types/bun": "latest",
    "@types/express": "^5.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1"
  }
}
