# Server
PORT=3003
ALLOWED_API_ORIGINS=http://localhost:3001
API_URL=http://localhost:3003

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Optional read replica — falls back to DATABASE_URL when unset
# DATABASE_REPLICA_URL=

# Supabase (auth)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Service-to-service auth (internal tRPC calls)
INTERNAL_API_KEY=

# Encryption key for @repo/encryption (64-character hex string, 32 bytes)
APP_ENCRYPTION_KEY=
