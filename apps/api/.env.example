# API server port (the dev script already sets 4001)
PORT=4001

# Comma-separated list of origins allowed by CORS
ALLOWED_API_ORIGINS=http://localhost:4000

# Postgres connection string used by Prisma (see prisma.config.ts).
# Supabase: use the "Session pooler" string from Project Settings → Database —
# the direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Supabase Storage for POST /files uploads into the public bucket "reclit".
# The publishable (anon) key works when the bucket allows anon inserts; if its
# RLS rejects them, put the service-role key in this same variable instead.
SUPABASE_URL=
SUPABASE_KEY=

# Trigger.dev background jobs (apps/api/trigger.config.ts). Dev key from the
# Trigger.dev dashboard -> project -> API keys. The api needs it to enqueue
# `run-ai-batch` jobs (`runAi.runCells` answers BAD_GATEWAY without it).
# `bun run trigger:dev` loads this file, so the local worker also gets
# DATABASE_URL, the Gemini key and the ElevenLabs key; a deployed Trigger
# environment needs them set in its own dashboard.
TRIGGER_SECRET_KEY=

# Google AI Studio key for Gemini via the Vercel AI SDK (src/ai/gemini.ts);
# the `google_search` node's Google Search grounding runs on the same key.
# Used by the Trigger.dev worker, not the api.
GOOGLE_GENERATIVE_AI_API_KEY=

# ElevenLabs key for Speech-to-Text (src/ai/elevenlabs.ts): an audio cell in an
# AI node's row is transcribed once and the result cached in the ExternalApi
# table. Used by the Trigger.dev worker, not the api; without it a run still
# completes and the prompt says the audio could not be transcribed.
ELEVENLABS_API_KEY=
